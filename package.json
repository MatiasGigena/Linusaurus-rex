{
  "name": "linusaurus-rex",
  "version": "0.1.0",
  "description": "A Linux desktop companion for Rex terminal sessions",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "Matias Gigena",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-electron/main.js && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "electron .",
    "package": "npm run build && electron-builder --linux AppImage deb --publish never",
    "package:dir": "npm run build && electron-builder --linux dir --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.matiasgigena.linusaurus-rex",
    "productName": "Linusaurus Rex",
    "directories": {"output": "release"},
    "files": ["dist/**/*", "dist-electron/**/*", "resources/**/*", "package.json"],
    "linux": {"category": "Development", "executableName": "linusaurus-rex", "icon": "resources/icon.png", "target": ["AppImage", "deb"]},
    "deb": {"maintainer": "Matias Gigena", "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libdrm2", "libgbm1"]}
  }
}
